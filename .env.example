# Environment Configuration — Velora Autonomous Agent
# Copy this file to .env (never commit .env)

# === Gemini API ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === GitHub ===
GITHUB_TOKEN=
GITHUB_REPOSITORY=AlirezaNezami96/Velora
GITHUB_USER_NAME=AlirezaNezami96
GITHUB_USER_EMAIL=AlirezaNezami96@users.noreply.github.com

# === Agent Behaviour ===
TIMEZONE=UTC
RUNS_PER_DAY=4
COMMITS_PER_RUN_MIN=10
COMMITS_PER_RUN_MAX=15
MAX_CHANGED_LINES_PER_COMMIT=50

# === Paths ===
# REPO_PATH defaults to "." (current working directory)
REPO_PATH=.
